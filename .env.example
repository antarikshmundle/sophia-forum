# Sophia Forum: environment variable NAMES only. Never put real values in this file.
# Real values go in .env.local (app) and .env.test.local (QA); both are Git-ignored.

# Supabase project URL and PUBLIC key (publishable/anon). Safe in the browser only because RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CMS rollout flags (server-only). Missing or unknown values mean "demo".
#   CMS_AUTH_MODE=demo|supabase      (supabase = real admin sign-in; fixed at BUILD time: rebuild + restart to switch)
#   CMS_FACULTY_MODE=demo|backend    (backend enables the /api/admin CMS routes; with CMS_AUTH_MODE=supabase the Faculty Manager
#                                     uses them too, fixed at BUILD time)
CMS_AUTH_MODE=demo
CMS_FACULTY_MODE=demo

# SOPHIA BOT (server-only; never NEXT_PUBLIC_). Off unless SOPHIA_BOT_ENABLED=true AND a key AND a model are set.
# On a Vercel production deployment the bot also stays off until a shared (distributed) rate limiter exists.
#   SOPHIA_BOT_ENABLED=true|false   (default false)
#   GEMINI_API_KEY=                 (Gemini API key, local development only; set it in the environment, never in a committed file)
#   GEMINI_MODEL=                   (Gemini model ID, e.g. a current Flash-Lite model; no built-in default)
# Shared (distributed) rate limiting for the bot: Upstash Redis REST credentials (console → Connect → REST). Server-only.
# Required on a Vercel production deployment; set both or neither (one alone keeps the bot off).
#   UPSTASH_REDIS_REST_URL=         (https://<database>.upstash.io)
#   UPSTASH_REDIS_REST_TOKEN=       (the Standard token; never the NEXT_PUBLIC_ prefix, never committed)
SOPHIA_BOT_ENABLED=false

# QA only, in .env.test.local (staging project only; the tests refuse anything else):
#   QA_SUPABASE_URL=  QA_SUPABASE_ANON_KEY=  QA_ADMIN_EMAIL=  QA_ADMIN_PASSWORD=
# Never add a service-role/secret key or a database URL to the app's environment.
